# Byte patch for the stock /vendor/bin/xtra-daemon, applied by build/lib/bytepatch.py.
# XtraIzatAdapter::onReceiveXtraServers loads the daemon's built-in
# https://path{1,2,3}.xtracloud.net URLs instead of the modem's bare host names,
# which doDownloadXtraDataOnce rejects as "unsupported url".
sha256-in	c17f4bf6da03f56eaad94e8922d397e388d9c3a50e23f1ffaebfaac407d390ed
sha256-out	17b1c3e605ebffba442de462aa0365adef83a1899b040d10eb2b2aac5eb9fa8e
# offset	original	patched	(arm64 instruction)
0x1aa4c	f50303aa	5507f970	mov x21, x3 -> adr x21, 0xcb37 (path3)
0x1aa50	f60302aa	7617f810	mov x22, x2 -> adr x22, 0xad3c (path2)
0x1aa68	e00301aa	e0bdf710	mov x0, x1 -> adr x0, 0xa224 (path1)
0x1aa6c	f70301aa	d7bdf710	mov x23, x1 -> adr x23, 0xa224 (path1)
