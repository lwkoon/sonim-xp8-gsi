# fstab.qcom for the GSI: no dm-verity on system (the GSI has no verity
# metadata), and file-based encryption with ICE in place of FDE on userdata.
# Do not use aes-256-xts here: it corrupts /data through the ICE path on this kernel.
--- a/etc/fstab.qcom
+++ b/etc/fstab.qcom
@@ -7,8 +7,8 @@
 
 # A/B fstab.qcom variant
 #<src>                                   <mnt_point>           <type> <mnt_flags and options>                          <fs_mgr_flags>
-/dev/block/bootdevice/by-name/system     /                     ext4   ro,barrier=1,discard                             wait,slotselect,verify
-/dev/block/bootdevice/by-name/userdata   /data                 ext4   nosuid,nodev,barrier=1,noauto_da_alloc,discard,noatime,lazytime   wait,check,forceencrypt=footer,crashcheck,quota,reservedsize=128M
+/dev/block/bootdevice/by-name/system     /                     ext4   ro,barrier=1,discard                             wait,slotselect
+/dev/block/bootdevice/by-name/userdata   /data                 ext4   nosuid,nodev,barrier=1,noauto_da_alloc,discard,noatime,lazytime   wait,check,formattable,quota,reservedsize=128M,fileencryption=ice:aes-256-cts:v1
 /devices/soc/c084000.sdhci/mmc_host*     /storage/sdcard1      vfat   nosuid,nodev                                     wait,voldmanaged=sdcard1:auto,encryptable=footer
 /dev/block/bootdevice/by-name/misc       /misc                 emmc   defaults                                         defaults
 /dev/block/bootdevice/by-name/modem      /vendor/firmware_mnt  vfat   ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0 wait,slotselect
